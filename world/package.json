{
  "name": "@xrift/world",
  "version": "0.1.0",
  "description": "XRift world template for creating WebXR experiences with React Three Fiber and physics simulation",
  "type": "module",
  "main": "./dist/remoteEntry.js",
  "module": "./dist/remoteEntry.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/remoteEntry.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:local": "playwright test --config tests/playwright.config.ts --project local-pc",
    "test:prod": "playwright test --config tests/playwright.config.ts --project prod-pc --project prod-sp --project prod-vr",
    "test:auth": "playwright codegen --save-storage=tests/.auth/xrift.json https://app.xrift.net/"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.3",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.65.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "@react-three/uikit": "^1.0.64",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@xrift/sdk": "^0.2.0",
    "baseline-browser-mapping": "^2.10.0",
    "playwright-webxr": "^0.7.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "three": "^0.183.1",
    "typescript": "^5.6.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xrift/world-components": "^0.60.0"
  }
}
