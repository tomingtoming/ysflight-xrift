{
  "world": {
    "distDir": "./dist",
    "title": "YSFLIGHT (ysflight-xrift)",
    "description": "YSFLIGHTの原典エンジン（WebAssembly）がXRiftの中で動く実験ワールド。台座に座ると機体に乗り込み、同じインスタンスの全員が同じ空を飛ぶ（対戦サーバはインスタンス内の誰か1人のブラウザ。PCが優先され、止まると別の人が引き継ぐ）。",
    "thumbnailPath": "thumbnail.png",
    "buildCommand": "npm run build",
    "ignore": [
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/*.js.map",
      "**/.gitkeep",
      "**/index.html",
      "**/__federation_shared_@react-three/drei-*.js",
      "**/__federation_shared_@react-three/fiber-*.js",
      "**/__federation_shared_@react-three/rapier-*.js",
      "**/__federation_shared_@xrift/world-components-*.js",
      "**/__federation_shared_three-*.js",
      "**/__federation_shared_three/addons/**",
      "**/__federation_shared_react-*.js",
      "**/__federation_shared_react-dom-*.js",
      "**/__federation_shared_react-dom/client-*.js",
      "**/__federation_shared_react/jsx-runtime-*.js",
      "**/rapier.es-*.js",
      "**/hls-*.js"
    ],
    "physics": {
      "gravity": 9.81,
      "allowInfiniteJump": true
    },
    "camera": {
      "near": 0.1,
      "far": 1000
    },
    "permissions": {
      "allowedCodeRules": [
        "no-rtc-connection"
      ],
      "allowedDomains": [
        "stun.l.google.com",
        "ysflight-xrift-signal.toming.workers.dev"
      ]
    }
  }
}
